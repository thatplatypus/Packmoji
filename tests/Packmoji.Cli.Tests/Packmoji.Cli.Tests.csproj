<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Packmoji.Cli\Packmoji.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The guides travel with the tests, so that a test can hold what they show to what pmj does.
         A test that finds no guide fails, and says which. -->
    <None Include="..\..\docs\cli.md" Link="docs\cli.md" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\docs\cli.md')" />
    <None Include="..\..\docs\publishing.md" Link="docs\publishing.md" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\docs\publishing.md')" />
    <None Include="..\..\docs\building.md" Link="docs\building.md" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\docs\building.md')" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample projects travel with the tests, which pack, install, build and run them. What a
         build of one left in it on this machine is no part of the sample. -->
    <None Include="..\..\samples\**\*" Exclude="..\..\samples\**\target\**;..\..\samples\**\packages\**" Link="samples\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scripts that make a release travel with the tests, with the file that says which version
         this is, so that the names of a release's programs and their digests are held without a release. -->
    <None Include="..\..\scripts\release-assets.sh" Link="scripts\release-assets.sh" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\scripts\release-assets.sh')" />
    <None Include="..\..\scripts\glibc-floor.sh" Link="scripts\glibc-floor.sh" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\scripts\glibc-floor.sh')" />
    <None Include="..\..\scripts\release-tag.sh" Link="scripts\release-tag.sh" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\scripts\release-tag.sh')" />
    <None Include="..\..\Directory.Build.props" Link="Directory.Build.props" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\.github\workflows\*.yml" Link="workflows\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
